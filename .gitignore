# dependencies (only needed for the optional relay + tests)
node_modules/

# local scratch: fetched reference pages, Multiplayer Piano sources, captures
_research/

# scraped art-pia assets. This holds a logged-in profile and your auth header,
# so it must never be committed or shared.
_scrape/

# impeccable detector state
.impeccable/

# local-only notes, not part of the published site
PLAN.md
REPORT.md

# browser-check output and scratch (tools/check*.cjs write captures here)
/_shots/
/tools/_scratch.cjs
/_*.txt
/_old_re/

# probe scratch: screenshots and per-run dumps. The two .txt files that are NOT
# prefixed are kept on purpose - they are the recorded measurements PLAN.md cites.
/tools/*.png
/tools/_*.txt

# logs / os noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# editor
.vscode/
.idea/
/_pub.txt 
